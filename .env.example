# ==============================================================================
# HostPanel — Ortam Değişkenleri Şablonu
# ------------------------------------------------------------------------------
# Bu dosyayı `.env` olarak KOPYALAMAYIN — install.sh `.env`'i sizin için
# güvenli rastgele değerlerle üretir. Bu şablon yalnızca hangi değişkenlerin
# kullanıldığını gösterir ve elle kurulum için referanstır.
#
# ⚠️  `.env` dosyası ASLA git'e gönderilmez (.gitignore ile dışlanmıştır).
# ==============================================================================

# ---- Genel ----
NODE_ENV=production
PORT=4000

# ---- Panel Erişimi ----
# Sunucunuzun public IP'si (install.sh otomatik algılar).
SERVER_IP=CHANGE_ME
# Tarayıcıdan panele erişeceğiniz adres (http://IP veya https://panel.alanadi.com).
FRONTEND_URL=http://CHANGE_ME
# Nginx'in dinleyeceği portlar.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Güvenlik (KRİTİK — güçlü, rastgele değerler) ----
# En az 32 karakter rastgele. Üretmek için: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_random_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- Panel Veritabanı (SQLite — panelin kendi verisi) ----
DATABASE_URL=file:/var/www/hosting_panel.db

# ---- Müşteri Veritabanları (MariaDB / MySQL) ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=hosting_panel
MYSQL_USER=panel_user
MYSQL_ADMIN_USER=root
# Aşağıdaki üçü güçlü ve rastgele olmalı: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong
MYSQL_PASSWORD=CHANGE_ME_strong
MYSQL_ADMIN_PASS=CHANGE_ME_strong

# ---- Redis (kuyruk / oturum / hız sınırı) ----
REDIS_PASSWORD=CHANGE_ME_strong

# ---- Hosting Dizinleri ve Servisler ----
WEB_ROOT=/var/www
NGINX_SITES_AVAILABLE=/var/www/nginx-vhosts
NGINX_SITES_ENABLED=/var/www/nginx-vhosts
PHP_FPM_SOCK_DIR=/var/run/php
FTP_USERLIST_FILE=/etc/vsftpd.userlist
FTP_SHELL=/usr/sbin/nologin
FTP_WEB_GROUP=www-data
MAIL_BASE=/var/mail/vhosts
BACKUP_BASE=/var/backups/hosting

# ---- SSL / Let's Encrypt ----
LETSENCRYPT_EMAIL=admin@example.com
CERTBOT_BIN=certbot

# ---- Webmail (opsiyonel) ----
# Roundcube/webmail kuruluysa adresini yazın; boşsa sidebar'da gizlenir.
NEXT_PUBLIC_WEBMAIL_URL=
NEXT_PUBLIC_API_URL=/api

# ---- Loglama ve Hız Sınırı ----
LOG_LEVEL=info
LOG_DIR=./logs
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# ==============================================================================
# İLK ADMİN HESABI (yalnızca ilk `seed` sırasında kullanılır)
# install.sh bunları kurulumda sorar ve geçici olarak set eder.
# ==============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_strong
