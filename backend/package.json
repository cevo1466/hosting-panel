{
  "name": "hosting-panel-backend",
  "version": "1.0.0",
  "description": "Enterprise Hosting Management Panel - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:push": "npx prisma db push --skip-generate",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "setup": "npm install && npx prisma generate && npx prisma db push --skip-generate && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "child_process": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.6.1",
    "systeminformation": "^5.21.22",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "prisma": "^5.10.0"
  }
}
